# Data folder (ignore everything except the two prepared workspaces)
data/*
!data/paperaudit-workspace/

# SPOT workspace: the RESULT artefacts travel, the paper sources do not.
# The JSONs are the resumable state of an in-progress experiment -- detector
# candidates, routing tables, verification reports and cached judge verdicts,
# each of which costs real API spend to regenerate. The 47 MB of paper.md is
# regenerable for free with `python scripts/download_spot.py`.
!data/spot-workspace/
data/spot-workspace/**/*.md

# Large source datasets
mcp-server/PaperAudit_Origin_Data/

# Execution outputs / experiment runs
outputs/
paperaudit_prova/

# Claude Code internals
.claude/worktrees/

# Run artifacts inside .claude (keep settings.json and SKILL.md files)
.claude/paper_*_data.json
.claude/skills/**/*.json

# Specific files to ignore
deepseek-claude-code.sh

# Lean verification projects. A Mathlib-backed project is ~7.4 GB of build
# output; MATH_VERIFICATION/Paper is the shared one every workspace paper uses.
# Never committed — /verify-math-lean recreates it on demand.
MATH_VERIFICATION/
